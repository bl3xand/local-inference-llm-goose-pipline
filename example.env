# Настройки этого компьютера. Скопируйте в .env (install.sh сделает это сам при первом запуске) и правьте там.
# После любой правки: ./install.sh
# Формат: ИМЯ=значение, по одной на строку. Комментарии только отдельной строкой. ~ и $HOME в путях раскрываются.

# ---------- Пути ----------
# Папка с моделями (*.gguf и mmproj-*.gguf). Пусто = папка models/ в этом репозитории.
MODELS_DIR=
# Программа сервера моделей
LLAMA_SERVER_BIN=/usr/bin/llama-server

# ---------- Сервер ----------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Через сколько секунд простоя модель выгружается из видеопамяти
SLEEP_IDLE_SECONDS=600
# Видеокарта: ROCm0 для AMD (HIP), CUDA0 для NVIDIA, Vulkan0 для Vulkan
DEVICE=ROCm0

# ---------- Память ----------
# Сколько видеопамяти (МиБ) оставлять свободной при загрузке модели. На карте 16 ГБ: 830 = около 0,1 ГБ, 1230 = около 0,5 ГБ,
# 2048 = около 1,3 ГБ. Слишком мало: рабочий стол вылетает или ядро убивает сервер. Слишком много: модель медленнее.
FIT_TARGET=830
# Исключения для отдельных моделей: имя=значение через пробел. Имя — как в списке моделей Goose.
FIT_TARGET_PER_MODEL=gemma-4-26b-q6=1230
# Окно контекста в токенах и исключения для отдельных моделей (тот же формат)
CTX_SIZE=131072
CTX_SIZE_PER_MODEL=
# Сколько запросов одновременно делят одно окно: главный агент плюс субагенты
PARALLEL=7
# Оперативная память (МиБ) под кэш прежних запросов
CACHE_RAM=2048
# Точность хранения контекста в памяти: q8_0 экономит память, f16 — точнее и вдвое больше
KV_CACHE_TYPE=q8_0
# Потоки процессора для чтения запроса и картинок (обычно число логических ядер)
THREADS_BATCH=16

# ---------- Рассуждения и ответ ----------
# Потолок рассуждений в токенах на один ответ. -1 = без потолка
REASONING_BUDGET=-1
# Самый длинный один ответ модели в токенах (Goose шлёт это как max_tokens)
OUTPUT_LIMIT=32768

# ---------- Картинки ----------
# Где кодируется картинка: пусто = на видеокарте, none = на процессоре (медленно, зато не трогает видеопамять)
MMPROJ_DEVICE=
# Размер картинки в токенах: пусто = стандартный маленький. Потолок: 4096 у семейства Qwen, 1120 у Gemma.
# Большой размер на видеокарте при малом FIT_TARGET ронял рабочий стол — ставить только вместе с MMPROJ_DEVICE=none.
IMAGE_MIN_TOKENS=

# ---------- Goose ----------
# Эти пять значений install.sh записывает в ~/.config/goose/config.yaml при каждом запуске.
# Режим подтверждений: auto, smart_approve, approve, chat
GOOSE_MODE=smart_approve
# При какой доле заполнения окна Goose сжимает контекст
GOOSE_AUTO_COMPACT_THRESHOLD=0.8
# Сколько ходов подряд может сделать агент и субагент
GOOSE_MAX_TURNS=200
GOOSE_SUBAGENT_MAX_TURNS=6
# Уровень рассуждений по умолчанию: low, medium, high, max
GOOSE_THINKING_EFFORT=max
# Модель при первой установке (потом её выбирают в окне Goose, и install.sh выбор не трогает)
DEFAULT_MODEL=ornith-1.5-35b
