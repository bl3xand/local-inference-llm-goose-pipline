# Settings of this computer. Copy to .env (install.sh does it on the first run) and edit there.
# After any change: ./install.sh
# Format: NAME=value, one per line. Comments only on their own line. ~ and $HOME in paths are expanded.

# ---------- Paths ----------
# Folder with the models (*.gguf and mmproj-*.gguf). Empty = the models/ folder of this repository.
MODELS_DIR=
# The model server binary
LLAMA_SERVER_BIN=/usr/bin/llama-server

# ---------- Server ----------
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Seconds without requests after which the model is unloaded from VRAM
SLEEP_IDLE_SECONDS=600
# GPU: ROCm0 for AMD (HIP), CUDA0 for NVIDIA, Vulkan0 for Vulkan
DEVICE=ROCm0

# ---------- Memory ----------
# VRAM (MiB) to keep free when a model is loaded. On a 16 GB card: 830 = about 0.1 GB, 1230 = about 0.5 GB,
# 2048 = about 1.3 GB. Too little: the desktop crashes or the kernel kills the server. Too much: the model is slower.
FIT_TARGET=830
# Exceptions for single models: name=value, space-separated. The name is the one in Goose's model list.
FIT_TARGET_PER_MODEL=gemma-4-26b-q6=1230
# Context window in tokens, and exceptions for single models (same format)
CTX_SIZE=131072
CTX_SIZE_PER_MODEL=
# How many requests share one window at a time: the main agent plus subagents
PARALLEL=7
# RAM (MiB) for the cache of earlier prompts
CACHE_RAM=2048
# Precision of the stored context: q8_0 saves memory, f16 is more exact and twice the size
KV_CACHE_TYPE=q8_0
# CPU threads for reading the prompt and pictures (usually the number of logical cores)
THREADS_BATCH=16

# ---------- Reasoning and reply ----------
# Reasoning cap in tokens per reply. -1 = no cap
REASONING_BUDGET=-1
# The longest single reply in tokens (Goose sends it as max_tokens)
OUTPUT_LIMIT=32768

# ---------- Pictures ----------
# Where a picture is encoded: empty = on the GPU, none = on the CPU (slow, but uses no VRAM)
MMPROJ_DEVICE=
# Picture size in tokens: empty = the default small one. Ceiling: 4096 for the Qwen family, 1120 for Gemma.
# A large size on the GPU with a small FIT_TARGET crashed the desktop - set it only together with MMPROJ_DEVICE=none.
IMAGE_MIN_TOKENS=

# ---------- Goose ----------
# install.sh writes these five values into ~/.config/goose/config.yaml on every run.
# Approval mode: auto, smart_approve, approve, chat
GOOSE_MODE=smart_approve
# The fraction of the window at which Goose compacts the context
GOOSE_AUTO_COMPACT_THRESHOLD=0.8
# How many turns in a row the agent and a subagent may take
GOOSE_MAX_TURNS=200
GOOSE_SUBAGENT_MAX_TURNS=6
# Default reasoning level: low, medium, high, max
GOOSE_THINKING_EFFORT=max
# Model for a first install (later it is chosen in the Goose window and install.sh leaves that choice alone)
DEFAULT_MODEL=ornith-1.5-35b
