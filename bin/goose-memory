#!/usr/bin/env python3
"""goose-memory - inspect or prune goose's GLOBAL memory (rules per project, `general`, auto PROGRESS entries).

  goose-memory show                 everything, by section, with size and age
  goose-memory clear NAME           delete one section (usually a project folder name)
  goose-memory forget 3m            delete sections not written to for 3 months (also 90d, 1y)
  goose-memory clear-all            delete everything

Without --yes it only shows what would be deleted. Each section is one file in ~/.config/goose/memory/.
Chat history is separate: see goose-forget.
"""
import os, re, sys, time
D = os.path.expanduser("~/.config/goose/memory")
files = sorted(f for f in os.listdir(D) if f.endswith(".txt")) if os.path.isdir(D) else []
def entries(path): return [e for e in open(path).read().split("\n\n") if e.strip()]
def age_days(f): return (time.time() - os.path.getmtime(os.path.join(D, f))) / 86400
args = [a for a in sys.argv[1:] if a != "--yes"]; yes = "--yes" in sys.argv
cmd = args[0] if args else "show"
if cmd == "show":
    total = 0
    for f in files:
        es = entries(os.path.join(D, f)); size = os.path.getsize(os.path.join(D, f)); total += size
        print(f"{f[:-4]}: {len(es)} entries, ~{size // 4} tokens, last written {age_days(f):.0f} days ago")
        for e in es[:20]:
            print("   -", " ".join(l for l in e.splitlines() if not l.startswith("#"))[:150].strip())
    print(f"Total: {len(files)} sections, ~{total // 4} tokens added to every session." if files else "Memory is empty.")
    sys.exit(0)
if cmd == "clear" and len(args) > 1:
    targets = [f for f in files if f[:-4] == args[1]]
elif cmd == "clear-all":
    targets = files
elif cmd == "forget" and len(args) > 1 and re.fullmatch(r"\d+\s*[dmy]", args[1].lower()):
    m = re.fullmatch(r"(\d+)\s*([dmy])", args[1].lower())
    days = int(m.group(1)) * {"d": 1, "m": 30, "y": 365}[m.group(2)]
    targets = [f for f in files if age_days(f) >= days]
else:
    sys.exit(__doc__)
if not targets:
    sys.exit("Nothing matches. Sections: " + (", ".join(f"{f[:-4]} ({age_days(f):.0f}d)" for f in files) or "none"))
print("Would delete: " + ", ".join(f"{t[:-4]} (last written {age_days(t):.0f} days ago)" for t in targets))
if not yes:
    sys.exit("Nothing deleted. Re-run the same command with --yes to delete.")
for t in targets:
    os.remove(os.path.join(D, t))
    try: os.remove(os.path.expanduser("~/.local/state/goose/todo-mirror/" + t[:-4] + ".json"))
    except OSError: pass
print("Deleted.")
